<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>FoileBrowser</RootNamespace>
    <AssemblyName>FoileBrowser</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Memory-footprint tuning (see docs/PRD §6.12) -->
  <PropertyGroup>
    <!-- Drop ICU (~22 MB); dates/sizes use invariant formatting (defers German i18n). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Workstation, non-concurrent GC keeps the managed heap smaller for a desktop app. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Feature switches: shrink the trimmed output and avoid unused subsystems. -->
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <NullabilityInfoContextSupport>false</NullabilityInfoContextSupport>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ask the GC to keep the heap tight (0..9); also set for the launcher via DOTNET_GCConserveMemory. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" Trim="false" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <!-- Trimming (applies at publish only). Reflection is made trim-safe in code; the archive-format
       assemblies are discovered reflectively, so they are rooted below to survive trimming. -->
  <!-- Opt into NativeAOT via -p:FoileAot=true (a custom prop the analyzer project never sees, so it
       isn't asked to AOT-compile). -->
  <PropertyGroup Condition="'$(FoileAot)' == 'true'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true' Or '$(PublishAot)' == 'true'">
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- The window icon is decoded at startup by the toolkit's own PNG decoder, so it ships as a
         plain embedded resource instead of a toolkit-specific asset pipeline. -->
    <EmbeddedResource Include="Assets/foilebrowser.png" LogicalName="foilebrowser.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FoileBrowser.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generator is a separate project; don't compile its sources into the app. -->
    <Compile Remove="Generators/**/*.cs" />
    <!-- Source generator: statically registers all archive-format descriptors (no reflection).
         Strip publish/AOT/RID properties so this netstandard2.0 analyzer isn't asked to AOT/trim. -->
    <ProjectReference Include="Generators\FoileBrowser.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      UndefineProperties="RuntimeIdentifier;PublishAot;PublishTrimmed;SelfContained;PublishSingleFile" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI toolkit: the NativeForms core plus the backends this build ships. Core never calls a
         native API; each backend is one platform's P/Invoke layer and only the one matching the
         running OS is ever realized — so there is no Skia, no GPU stack and no bundled font in the
         process (PRD §6.12). -->
    <ProjectReference Include="..\..\NativeForms\NativeForms.Core\NativeForms.Core.csproj" />
    <ProjectReference Include="..\..\NativeForms\NativeForms.Backends.Gtk\NativeForms.Backends.Gtk.csproj" />
    <ProjectReference Include="..\..\NativeForms\NativeForms.Backends.Windows\NativeForms.Backends.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Dockable multi-pane layout is in-house (src/Docking + Views/DockLayoutView), no Dock.* deps -->
    <!-- Archive & filesystem-image formats (LGPL-3.0), PRD §5/§6.11 -->
    <PackageReference Include="Hawkynt.FileFormats.Archives" Version="1.0.0.696" />
    <PackageReference Include="Hawkynt.FileFormats.FileSystems" Version="1.0.0.696" />
    <!-- Image metadata for the file-list columns; audio/video columns use ffprobe when installed.
         SkiaSharp ships Windows/macOS native binaries itself but not the Linux one — Avalonia used to
         pull that in transitively, so it is referenced explicitly now. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
  </ItemGroup>

</Project>
