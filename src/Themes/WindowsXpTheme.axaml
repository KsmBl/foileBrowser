<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FoileBrowser.Themes.WindowsXpTheme">
  <!--
    Windows XP "Luna Blue" skin (PRD §6.8). Layered on top of FluentTheme: it re-colours the
    resources the app binds to and restyles the controls it actually uses, rather than replacing
    every control template — that keeps it small, and every Avalonia control keeps working.
    Declared as a Styles subclass (compiled XAML, no runtime reflection) so it stays AOT-safe.
  -->

  <Styles.Resources>
    <!-- == Luna palette == -->
    <Color x:Key="XpFaceColor">#ECE9D8</Color>          <!-- dialog/toolbar face -->
    <Color x:Key="XpFieldColor">#FFFFFF</Color>          <!-- list/text field -->
    <Color x:Key="XpTextColor">#000000</Color>
    <Color x:Key="XpDimTextColor">#5A5A5A</Color>
    <Color x:Key="XpBorderColor">#ACA899</Color>         <!-- 3D shadow / separator -->
    <Color x:Key="XpControlBorderColor">#003C74</Color>  <!-- button outline -->
    <Color x:Key="XpSelectionColor">#316AC5</Color>      <!-- Luna selection blue -->
    <Color x:Key="XpHoverColor">#DCE9F9</Color>

    <SolidColorBrush x:Key="XpFace" Color="{StaticResource XpFaceColor}" />
    <SolidColorBrush x:Key="XpField" Color="{StaticResource XpFieldColor}" />
    <SolidColorBrush x:Key="XpText" Color="{StaticResource XpTextColor}" />
    <SolidColorBrush x:Key="XpBorder" Color="{StaticResource XpBorderColor}" />
    <SolidColorBrush x:Key="XpControlBorder" Color="{StaticResource XpControlBorderColor}" />
    <SolidColorBrush x:Key="XpSelection" Color="{StaticResource XpSelectionColor}" />
    <SolidColorBrush x:Key="XpHover" Color="{StaticResource XpHoverColor}" />

    <!-- Classic top-lit button/header gradient -->
    <LinearGradientBrush x:Key="XpButtonFace" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#FFFFFF" />
      <GradientStop Offset="0.45" Color="#F2F0E4" />
      <GradientStop Offset="0.55" Color="#EAE7D6" />
      <GradientStop Offset="1" Color="#DFDBC8" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="XpButtonHover" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#FFFFFF" />
      <GradientStop Offset="0.5" Color="#FFF3CD" />
      <GradientStop Offset="1" Color="#FFD98A" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="XpButtonPressed" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#E0DCC8" />
      <GradientStop Offset="1" Color="#F5F3E8" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="XpHeaderFace" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#FFFFFF" />
      <GradientStop Offset="1" Color="#E6E3D4" />
    </LinearGradientBrush>

    <!-- == The keys the app's own views bind to == -->
    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="{StaticResource XpFieldColor}" />
    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="{StaticResource XpFaceColor}" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="{StaticResource XpBorderColor}" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="{StaticResource XpBorderColor}" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="{StaticResource XpDimTextColor}" />

    <!-- == Fluent's own keys, so stock controls follow suit == -->
    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="{StaticResource XpFaceColor}" />
    <SolidColorBrush x:Key="ThemeForegroundBrush" Color="{StaticResource XpTextColor}" />
    <SolidColorBrush x:Key="ThemeBorderMidBrush" Color="{StaticResource XpBorderColor}" />
    <Color x:Key="SystemAccentColor">#316AC5</Color>
    <Color x:Key="SystemAccentColorLight1">#5A8AD8</Color>
    <Color x:Key="SystemAccentColorDark1">#25508F</Color>
    <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">3</CornerRadius>

    <!-- Luna framed its dialogs in the same blue as the title bar -->
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#0A5BC4" />
    <Thickness x:Key="DialogBorderThickness">2</Thickness>

    <!-- Flat, top-lit column headers with a hairline separator, as in Explorer's details view -->
    <StaticResource x:Key="ColumnHeaderBackground" ResourceKey="XpHeaderFace" />
    <StaticResource x:Key="ColumnHeaderBorderBrush" ResourceKey="XpBorder" />
    <Thickness x:Key="ColumnHeaderBorderThickness">0,0,1,0</Thickness>
    <FontWeight x:Key="ColumnHeaderFontWeight">Normal</FontWeight>
  </Styles.Resources>

  <!-- Tahoma at 11px is the XP shell font; fall back to whatever the system has. -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource XpFace}" />
    <Setter Property="Foreground" Value="{StaticResource XpText}" />
    <Setter Property="FontFamily" Value="Tahoma, Verdana, DejaVu Sans, sans-serif" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource XpButtonFace}" />
    <Setter Property="BorderBrush" Value="{StaticResource XpControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Foreground" Value="{StaticResource XpText}" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource XpButtonHover}" />
    <Setter Property="BorderBrush" Value="{StaticResource XpControlBorder}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource XpText}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource XpButtonPressed}" />
    <Setter Property="BorderBrush" Value="{StaticResource XpControlBorder}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource XpText}" />
  </Style>

  <Style Selector="ToggleButton">
    <Setter Property="Background" Value="{StaticResource XpButtonFace}" />
    <Setter Property="BorderBrush" Value="{StaticResource XpControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource XpButtonPressed}" />
    <Setter Property="BorderBrush" Value="{StaticResource XpControlBorder}" />
  </Style>

  <!-- Sunken white fields, the XP hallmark -->
  <Style Selector="TextBox, AutoCompleteBox, ComboBox, NumericUpDown">
    <Setter Property="Background" Value="{StaticResource XpField}" />
    <Setter Property="BorderBrush" Value="{StaticResource XpBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource XpText}" />
  </Style>

  <Style Selector="ListBox, TreeView">
    <Setter Property="Background" Value="{StaticResource XpField}" />
    <Setter Property="Foreground" Value="{StaticResource XpText}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource XpHover}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource XpSelection}" />
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource XpSelection}" />
  </Style>

  <Style Selector="Button.colheader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource XpHover}" />
    <Setter Property="BorderBrush" Value="{StaticResource XpBorder}" />
  </Style>

  <!-- Folder-tab look for the tab strip -->
  <Style Selector="TabItem">
    <Setter Property="Background" Value="{StaticResource XpButtonFace}" />
    <Setter Property="Foreground" Value="{StaticResource XpText}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="10,3" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Background" Value="{StaticResource XpField}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="Menu, ContextMenu, MenuItem">
    <Setter Property="Background" Value="{StaticResource XpFace}" />
    <Setter Property="Foreground" Value="{StaticResource XpText}" />
  </Style>
  <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource XpSelection}" />
  </Style>

  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="#F1EFE2" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="#40A02B" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
</Styles>
