<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:FoileBrowser"
             x:Class="FoileBrowser.App"
             RequestedThemeVariant="Default">
  <!-- "Default" theme variant follows the OS light/dark setting (PRD §6.8). -->

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
