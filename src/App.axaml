<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:FoileBrowser"
             xmlns:vm="using:FoileBrowser.ViewModels"
             xmlns:views="using:FoileBrowser.Views"
             xmlns:dockThemes="using:Dock.Avalonia.Themes.Fluent"
             xmlns:dockControls="using:Dock.Avalonia.Controls"
             x:Class="FoileBrowser.App"
             RequestedThemeVariant="Default">
  <!-- "Default" theme variant follows the OS light/dark setting (PRD §6.8). -->

  <Application.Resources>
    <!-- Row-density setting; overridden at runtime from AppSettings.RowHeight (PRD §6.8). -->
    <x:Double x:Key="RowHeight">24</x:Double>
  </Application.Resources>

  <Application.DataTemplates>
    <!-- A tab is a Dock document, not a ViewModelBase, so it needs an explicit view mapping. -->
    <DataTemplate DataType="vm:FileTabViewModel">
      <views:FileTabView />
    </DataTemplate>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <dockThemes:DockFluentTheme />

    <!-- Hide a pane's tab strip while it holds a single tab (PRD §6.2). -->
    <Style Selector="dockControls|DocumentTabStrip">
      <Setter Property="IsVisible"
              Value="{Binding ItemCount, RelativeSource={RelativeSource Self}, Converter={x:Static views:MainWindow.MoreThanOne}}" />
    </Style>
  </Application.Styles>
</Application>
