<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:FoileBrowser"
             xmlns:vm="using:FoileBrowser.ViewModels"
             xmlns:views="using:FoileBrowser.Views"
             x:Class="FoileBrowser.App"
             RequestedThemeVariant="Default">
  <!-- "Default" theme variant follows the OS light/dark setting (PRD §6.8). -->

  <Application.Resources>
    <!-- Row-density setting; overridden at runtime from AppSettings.RowHeight (PRD §6.8). -->
    <x:Double x:Key="RowHeight">24</x:Double>

    <!-- File-list column-header look; skins override these (PRD §6.1, §6.8). -->
    <SolidColorBrush x:Key="ColumnHeaderBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ColumnHeaderBorderBrush" Color="Transparent" />
    <Thickness x:Key="ColumnHeaderBorderThickness">0</Thickness>
    <FontWeight x:Key="ColumnHeaderFontWeight">SemiBold</FontWeight>

    <!-- Outline drawn around dialogs so they stand out from the window behind them on compositors
         that draw no decoration of their own (sway/i3 and other tiling WMs) — PRD §6.8. -->
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#8C8C8C" />
    <Thickness x:Key="DialogBorderThickness">2</Thickness>
  </Application.Resources>

  <Application.DataTemplates>
    <!-- A tab is a Dock document, not a ViewModelBase, so it needs an explicit view mapping. -->
    <DataTemplate DataType="vm:FileTabViewModel">
      <views:FileTabView />
    </DataTemplate>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />

    <!-- Window's own BorderBrush/BorderThickness aren't template-bound by the theme, so the outline
         goes on the content presenter that wraps every dialog's content instead. -->
    <Style Selector="Window.dialog /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}" />
      <Setter Property="BorderThickness" Value="{DynamicResource DialogBorderThickness}" />
    </Style>
  </Application.Styles>
</Application>
