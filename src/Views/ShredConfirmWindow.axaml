<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FoileBrowser.Views.ShredConfirmWindow" Classes="dialog"
        Width="480" SizeToContent="Height" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Delete permanently">
  <StackPanel Margin="16" Spacing="12">

    <TextBlock Text="Overwrite with zeroes and delete permanently?" FontSize="15" FontWeight="SemiBold"
               TextWrapping="Wrap" />

    <TextBlock x:Name="TargetsText" TextWrapping="Wrap" Opacity="0.85" />

    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1"
            CornerRadius="3" Padding="10">
      <StackPanel Spacing="6">
        <TextBlock Text="This does not go to the trash and cannot be undone."
                   FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                   Text="Overwriting only reliably destroys the old data on a traditional filesystem on rotating media. On SSDs (wear levelling, TRIM), copy-on-write filesystems such as btrfs and ZFS, and journalled, compressed, RAID or network storage, the original blocks can survive this pass. Treat it as making casual recovery hard, not as a guaranteed wipe." />
      </StackPanel>
    </Border>

    <CheckBox x:Name="ConfirmBox" Content="I understand — delete these items permanently"
              IsCheckedChanged="OnConfirmChanged" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancel" IsCancel="True" />
      <Button x:Name="ShredButton" Content="Overwrite and delete" Click="OnConfirm" IsEnabled="False"
              Foreground="#E06C6C" />
    </StackPanel>
  </StackPanel>
</Window>
