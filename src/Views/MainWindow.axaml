<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FoileBrowser.ViewModels"
        xmlns:models="using:FoileBrowser.Models"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="FoileBrowser.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="900" Height="600"
        Title="foileBrowser">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Window.KeyBindings>
    <KeyBinding Gesture="Alt+Left" Command="{Binding GoBackCommand}" />
    <KeyBinding Gesture="Alt+Right" Command="{Binding GoForwardCommand}" />
    <KeyBinding Gesture="Alt+Up" Command="{Binding GoUpCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
  </Window.KeyBindings>

  <DockPanel>

    <!-- Toolbar + editable path bar (PRD §6.1) -->
    <Border DockPanel.Dock="Top" Padding="6" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,8,*,Auto">
        <Button Grid.Column="0" Content="←" ToolTip.Tip="Back (Alt+Left)" Command="{Binding GoBackCommand}" />
        <Button Grid.Column="1" Content="→" ToolTip.Tip="Forward (Alt+Right)" Command="{Binding GoForwardCommand}" Margin="4,0,0,0" />
        <Button Grid.Column="2" Content="↑" ToolTip.Tip="Up (Alt+Up)" Command="{Binding GoUpCommand}" Margin="4,0,0,0" />
        <Button Grid.Column="3" Content="⟳" ToolTip.Tip="Refresh (F5)" Command="{Binding RefreshCommand}" Margin="4,0,0,0" />

        <TextBox Grid.Column="5" Text="{Binding PathBarText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="Type a path and press Enter" VerticalContentAlignment="Center">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding NavigatePathBarCommand}" />
          </TextBox.KeyBindings>
        </TextBox>

        <ToggleButton Grid.Column="6" Content="Hidden" ToolTip.Tip="Show hidden files"
                      IsChecked="{Binding ShowHidden, Mode=TwoWay}" Margin="4,0,0,0" />
      </Grid>
    </Border>

    <!-- Status bar (PRD §6.12 shows item counts / errors) -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120" Height="4"
                     IsVisible="{Binding IsLoading}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Column header (clickable to sort — PRD §6.1) -->
    <Grid DockPanel.Dock="Top" Margin="6,4,22,0"
          ColumnDefinitions="28,*,110,120,160">
      <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.Name}"
              Content="Name" />
      <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.Size}"
              Content="Size" />
      <Button Grid.Column="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.Type}"
              Content="Type" />
      <Button Grid.Column="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.Modified}"
              Content="Modified" />
    </Grid>

    <!-- Virtualized file list (PRD §6.12 100k-entry lists without freeze) -->
    <ListBox ItemsSource="{Binding Entries}"
             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
             DoubleTapped="OnEntryActivated"
             KeyDown="OnListKeyDown"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.Styles>
        <Style Selector="Button.header">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Padding" Value="4,2" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="MinHeight" Value="26" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:FileEntryViewModel">
          <Grid ColumnDefinitions="28,*,110,120,160" Height="24">
            <TextBlock Grid.Column="0" Text="{Binding Glyph}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Opacity="{Binding IsHidden, Converter={x:Static vm:BoolOpacityConverter.Instance}}" />
            <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
            <TextBlock Grid.Column="3" Text="{Binding TypeDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="4" Text="{Binding ModifiedDisplay}" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</Window>
