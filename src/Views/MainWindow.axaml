<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FoileBrowser.ViewModels"
        xmlns:views="using:FoileBrowser.Views"
        xmlns:dock="using:Dock.Avalonia.Controls"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
        x:Class="FoileBrowser.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/foilebrowser.png"
        Width="1100" Height="680"
        Title="foileBrowser">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <!-- Window key bindings are generated at runtime from the command registry so hotkeys are
       user-rebindable (PRD §6.6). F2 (rename) and Delete (trash) stay list-scoped in the file list
       so they never hijack those keys while typing in a text box. -->

  <Panel>
  <DockPanel>

    <!-- Menu bar -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="New _Folder" InputGesture="Ctrl+Shift+N" Command="{Binding NewFolderCommand}" />
        <MenuItem Header="New F_ile" Command="{Binding NewFileCommand}" />
        <Separator />
        <MenuItem Header="_Rename…" InputGesture="F2" Command="{Binding RenameSelectedCommand}" />
        <MenuItem Header="_Delete to Trash" InputGesture="Delete" Command="{Binding DeleteSelectedCommand}" />
        <MenuItem Header="_Batch Rename…" Command="{Binding BatchRenameCommand}" />
        <Separator />
        <MenuItem Header="Copy _Path" Command="{Binding CopyPathCommand}" />
        <MenuItem Header="Copy _Name" Command="{Binding CopyNameCommand}" />
        <Separator />
        <MenuItem Header="P_roperties" InputGesture="Alt+Enter" Command="{Binding ShowPropertiesCommand}" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Copy to Other Pane" InputGesture="F6" Command="{Binding CopyToOtherCommand}" />
        <MenuItem Header="Move to Other Pane" InputGesture="F7" Command="{Binding MoveToOtherCommand}" />
        <Separator />
        <MenuItem Header="Extract Archive Here" Command="{Binding ExtractHereCommand}" />
        <MenuItem Header="Identify File" Command="{Binding IdentifyFileCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="New _Tab" InputGesture="Ctrl+T" Command="{Binding AddTabCommand}" />
        <MenuItem Header="New _Pane (split)" Command="{Binding AddPaneCommand}" />
        <MenuItem Header="_Close Tab" InputGesture="Ctrl+W" Command="{Binding CloseTabCommand}" />
        <Separator />
        <MenuItem Header="_Toolbar" Command="{Binding ToggleToolbarCommand}" />
        <MenuItem Header="_Inspector" InputGesture="Ctrl+I" Command="{Binding ToggleInspectorCommand}" />
        <MenuItem Header="_Hidden Files" Command="{Binding ToggleHiddenCommand}" />
        <Separator />
        <MenuItem Header="Size _Units" Command="{Binding CycleSizeUnitCommand}" />
        <MenuItem Header="Date _Format" Command="{Binding CycleDateFormatCommand}" />
        <Separator />
        <MenuItem Header="_Command Palette…" InputGesture="Ctrl+P" Command="{Binding OpenCommandPaletteCommand}" />
        <MenuItem Header="_Settings…" Command="{Binding OpenSettingsCommand}" />
      </MenuItem>
      <MenuItem Header="_Go">
        <MenuItem Header="_Back" InputGesture="Alt+Left" Command="{Binding GoBackCommand}" />
        <MenuItem Header="_Forward" InputGesture="Alt+Right" Command="{Binding GoForwardCommand}" />
        <MenuItem Header="_Up" InputGesture="Alt+Up" Command="{Binding GoUpCommand}" />
        <MenuItem Header="_Refresh" InputGesture="F5" Command="{Binding RefreshActiveCommand}" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="Open _Terminal Here" Command="{Binding OpenTerminalHereCommand}" />
        <MenuItem Header="_Open With…" Command="{Binding OpenSelectedExternallyCommand}" />
        <MenuItem Header="_Pin Current Folder" Command="{Binding PinFavoriteCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About foileBrowser" Command="{Binding ShowAboutCommand}" />
      </MenuItem>
    </Menu>

    <!-- Global operations toolbar (PRD §6.3) — emoji icons with text tooltips; hideable via View menu -->
    <Border DockPanel.Dock="Top" Padding="6" IsVisible="{Binding IsToolbarVisible}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <!-- Data-driven so buttons can be reordered by dragging one onto another (PRD §6.8); hidden
           buttons collapse. Back/forward/up/refresh live in each pane's own nav bar, not here. -->
      <ItemsControl x:Name="ToolbarItemsHost" ItemsSource="{Binding ToolbarItems}" DragDrop.AllowDrop="True">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToolbarItemViewModel">
            <Button Content="{Binding Content}" Command="{Binding Command}" ToolTip.Tip="{Binding Tooltip}"
                    FontSize="{Binding FontSize}" Padding="7,3" IsVisible="{Binding IsVisible}"
                    PointerPressed="OnToolbarItemPressed" PointerMoved="OnToolbarItemMoved" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Background operation queue (PRD §6.3) -->
    <Border DockPanel.Dock="Bottom" Padding="6"
            IsVisible="{Binding OperationQueue.Operations.Count}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
      <ItemsControl ItemsSource="{Binding OperationQueue.Operations}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FileOperationViewModel">
            <Grid ColumnDefinitions="*,160,Auto,Auto" Margin="0,2">
              <TextBlock Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" VerticalAlignment="Center" Margin="6,0" />
              <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" Margin="6,0" FontSize="11" />
              <Button Grid.Column="3" Content="✕" FontSize="10" Padding="4,0" Command="{Binding CancelCommand}" IsVisible="{Binding IsActive}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Inspector panel (PRD §6.5) -->
    <Border DockPanel.Dock="Right" Width="300" IsVisible="{Binding IsInspectorOpen}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1,0,0,0">
      <Panel>
        <TextBlock Text="Select an item to preview" Opacity="0.5" HorizontalAlignment="Center"
                   VerticalAlignment="Center" IsVisible="{Binding Preview, Converter={x:Static views:MainWindow.IsNullConverter}}" />
        <views:PreviewView DataContext="{Binding Preview}" />
      </Panel>
    </Border>

    <!-- Dockable panes: split / tab / float freely with sizable splitters (PRD §6.2) -->
    <dock:DockControl Layout="{Binding Layout}" Factory="{Binding DockFactory}" InitializeLayout="False" InitializeFactory="False" />

  </DockPanel>

  <!-- Command palette overlay (PRD §6.6) -->
  <Border IsVisible="{Binding CommandPalette.IsOpen}" Background="#80000000">
    <Border Width="560" MaxHeight="420" VerticalAlignment="Top" Margin="0,80,0,0"
            HorizontalAlignment="Center" CornerRadius="8" Padding="8"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1">
      <DockPanel>
        <TextBox x:Name="PaletteQueryBox" DockPanel.Dock="Top"
                 Text="{Binding CommandPalette.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="Type a command…" KeyDown="OnPaletteKeyDown" />
        <ListBox Margin="0,8,0,0" MaxHeight="330"
                 ItemsSource="{Binding CommandPalette.Results}"
                 SelectedItem="{Binding CommandPalette.Selected, Mode=TwoWay}"
                 DoubleTapped="OnPaletteItemActivated">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CommandItem">
              <Grid ColumnDefinitions="Auto,*,Auto" Height="26">
                <TextBlock Grid.Column="0" Text="{Binding Category}" Opacity="0.55" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                <Border Grid.Column="2" IsVisible="{Binding Gesture, Converter={x:Static views:MainWindow.NotNullConverter}}"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="3" Padding="5,1">
                  <TextBlock Text="{Binding Gesture}" FontSize="11" Opacity="0.8" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Border>

  </Panel>
</Window>
