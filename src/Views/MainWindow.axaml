<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FoileBrowser.ViewModels"
        xmlns:views="using:FoileBrowser.Views"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
        x:Class="FoileBrowser.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/foilebrowser.png"
        Width="1100" Height="680"
        Title="foileBrowser">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+P" Command="{Binding OpenCommandPaletteCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding OpenCommandPaletteCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding RenameSelectedCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding NewFolderCommand}" />
    <KeyBinding Gesture="F6" Command="{Binding CopyToOtherCommand}" />
    <KeyBinding Gesture="F7" Command="{Binding MoveToOtherCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding ToggleInspectorCommand}" />
  </Window.KeyBindings>

  <Panel>
  <DockPanel>

    <!-- Global operations toolbar (PRD §6.3) -->
    <Border DockPanel.Dock="Top" Padding="6" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Content="New Folder" Command="{Binding NewFolderCommand}" ToolTip.Tip="New folder (Ctrl+Shift+N)" />
        <Button Content="New File" Command="{Binding NewFileCommand}" />
        <Button Content="Rename" Command="{Binding RenameSelectedCommand}" ToolTip.Tip="Rename (F2)" />
        <Button Content="Delete" Command="{Binding DeleteSelectedCommand}" ToolTip.Tip="Delete to trash (Del)" />
        <Border Width="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="4,2" />
        <Button Content="Copy →" Command="{Binding CopyToOtherCommand}" ToolTip.Tip="Copy to other pane (F6)" />
        <Button Content="Move →" Command="{Binding MoveToOtherCommand}" ToolTip.Tip="Move to other pane (F7)" />
        <Button Content="Copy Path" Command="{Binding CopyPathCommand}" />
        <Button Content="Copy Name" Command="{Binding CopyNameCommand}" />
        <Button Content="Batch…" Command="{Binding BatchRenameCommand}" ToolTip.Tip="Batch rename items in this folder" />
        <Border Width="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="4,2" />
        <Button Content="Terminal" Command="{Binding OpenTerminalHereCommand}" ToolTip.Tip="Open terminal here" />
        <Button Content="Pin" Command="{Binding PinFavoriteCommand}" ToolTip.Tip="Pin current folder to favorites" />
        <ToggleButton Content="Dual pane" IsChecked="{Binding IsDualPane, Mode=OneWay}"
                      Command="{Binding ToggleDualPaneCommand}" ToolTip.Tip="Toggle single/dual pane" />
        <ToggleButton Content="Inspector" IsChecked="{Binding IsInspectorOpen, Mode=OneWay}"
                      Command="{Binding ToggleInspectorCommand}" ToolTip.Tip="Toggle inspector (Ctrl+I)" />
        <Button Content="⚙" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings" />
      </StackPanel>
    </Border>

    <!-- Background operation queue (PRD §6.3) -->
    <Border DockPanel.Dock="Bottom" Padding="6"
            IsVisible="{Binding OperationQueue.Operations.Count}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
      <ItemsControl ItemsSource="{Binding OperationQueue.Operations}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FileOperationViewModel">
            <Grid ColumnDefinitions="*,160,Auto,Auto" Margin="0,2">
              <TextBlock Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" VerticalAlignment="Center" Margin="6,0" />
              <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" Margin="6,0" FontSize="11" />
              <Button Grid.Column="3" Content="✕" FontSize="10" Padding="4,0" Command="{Binding CancelCommand}" IsVisible="{Binding IsActive}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Collapsible sidebar (PRD §6.2) -->
    <Border DockPanel.Dock="Left" Width="210" Padding="6"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Sidebar}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SidebarItemViewModel">
              <StackPanel Margin="0,1">
                <!-- Section header -->
                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="2,8,0,2"
                           IsVisible="{Binding IsHeader}" Opacity="0.7" FontSize="12" />
                <!-- Navigable favorite / drive -->
                <Grid IsVisible="{Binding IsNavigable}" ColumnDefinitions="*,Auto">
                  <Button Grid.Column="0" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" Background="Transparent" Padding="4,3"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenSidebarItemCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Glyph}" FontSize="12" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <ProgressBar Minimum="0" Maximum="1" Value="{Binding UsedFraction}" Height="4"
                                   Margin="0,3,0,0" IsVisible="{Binding HasCapacity}" />
                      <TextBlock Text="{Binding FreeSpaceDisplay}" FontSize="10" Opacity="0.6"
                                 IsVisible="{Binding HasCapacity}" />
                      <TextBlock Text="{Binding FileSystem}" FontSize="10" Opacity="0.5"
                                 IsVisible="{Binding HasFileSystem}" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="1" Content="⏏" FontSize="12" Padding="5,0" Background="Transparent"
                          VerticalAlignment="Center" ToolTip.Tip="Eject / unmount"
                          IsVisible="{Binding IsEjectable}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).EjectCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Inspector panel (PRD §6.5) -->
    <Border DockPanel.Dock="Right" Width="300" IsVisible="{Binding IsInspectorOpen}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1,0,0,0">
      <Panel>
        <TextBlock Text="Select an item to preview" Opacity="0.5" HorizontalAlignment="Center"
                   VerticalAlignment="Center" IsVisible="{Binding Preview, Converter={x:Static views:MainWindow.IsNullConverter}}" />
        <views:PreviewView DataContext="{Binding Preview}" />
      </Panel>
    </Border>

    <!-- Panes with splitter (PRD §6.2 dual pane) -->
    <Grid x:Name="PaneGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="{Binding IsDualPane, Converter={x:Static views:MainWindow.PaneColumnWidthConverter}}" />
      </Grid.ColumnDefinitions>
      <views:PaneView Grid.Column="0" DataContext="{Binding LeftPane}" />
      <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"
                    IsVisible="{Binding IsDualPane}" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <views:PaneView Grid.Column="2" DataContext="{Binding RightPane}"
                      IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsDualPane}" />
    </Grid>

  </DockPanel>

  <!-- Command palette overlay (PRD §6.6) -->
  <Border IsVisible="{Binding CommandPalette.IsOpen}" Background="#80000000">
    <Border Width="560" MaxHeight="420" VerticalAlignment="Top" Margin="0,80,0,0"
            HorizontalAlignment="Center" CornerRadius="8" Padding="8"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1">
      <DockPanel>
        <TextBox x:Name="PaletteQueryBox" DockPanel.Dock="Top"
                 Text="{Binding CommandPalette.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="Type a command…" KeyDown="OnPaletteKeyDown" />
        <ListBox Margin="0,8,0,0" MaxHeight="330"
                 ItemsSource="{Binding CommandPalette.Results}"
                 SelectedItem="{Binding CommandPalette.Selected, Mode=TwoWay}"
                 DoubleTapped="OnPaletteItemActivated">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CommandItem">
              <Grid ColumnDefinitions="Auto,*,Auto" Height="26">
                <TextBlock Grid.Column="0" Text="{Binding Category}" Opacity="0.55" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                <Border Grid.Column="2" IsVisible="{Binding Gesture, Converter={x:Static views:MainWindow.NotNullConverter}}"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="3" Padding="5,1">
                  <TextBlock Text="{Binding Gesture}" FontSize="11" Opacity="0.8" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Border>

  </Panel>
</Window>
