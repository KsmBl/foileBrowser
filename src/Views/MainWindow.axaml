<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FoileBrowser.ViewModels"
        xmlns:views="using:FoileBrowser.Views"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
        x:Class="FoileBrowser.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="680"
        Title="foileBrowser">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Window.KeyBindings>
    <KeyBinding Gesture="F2" Command="{Binding RenameSelectedCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding NewFolderCommand}" />
    <KeyBinding Gesture="F6" Command="{Binding CopyToOtherCommand}" />
    <KeyBinding Gesture="F7" Command="{Binding MoveToOtherCommand}" />
  </Window.KeyBindings>

  <DockPanel>

    <!-- Global operations toolbar (PRD §6.3) -->
    <Border DockPanel.Dock="Top" Padding="6" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Content="New Folder" Command="{Binding NewFolderCommand}" ToolTip.Tip="New folder (Ctrl+Shift+N)" />
        <Button Content="New File" Command="{Binding NewFileCommand}" />
        <Button Content="Rename" Command="{Binding RenameSelectedCommand}" ToolTip.Tip="Rename (F2)" />
        <Button Content="Delete" Command="{Binding DeleteSelectedCommand}" ToolTip.Tip="Delete to trash (Del)" />
        <Border Width="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="4,2" />
        <Button Content="Copy →" Command="{Binding CopyToOtherCommand}" ToolTip.Tip="Copy to other pane (F6)" />
        <Button Content="Move →" Command="{Binding MoveToOtherCommand}" ToolTip.Tip="Move to other pane (F7)" />
        <Button Content="Copy Path" Command="{Binding CopyPathCommand}" />
        <Button Content="Copy Name" Command="{Binding CopyNameCommand}" />
        <Border Width="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="4,2" />
        <ToggleButton Content="Dual pane" IsChecked="{Binding IsDualPane, Mode=OneWay}"
                      Command="{Binding ToggleDualPaneCommand}" ToolTip.Tip="Toggle single/dual pane" />
      </StackPanel>
    </Border>

    <!-- Background operation queue (PRD §6.3) -->
    <Border DockPanel.Dock="Bottom" Padding="6"
            IsVisible="{Binding OperationQueue.Operations.Count}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
      <ItemsControl ItemsSource="{Binding OperationQueue.Operations}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FileOperationViewModel">
            <Grid ColumnDefinitions="*,160,Auto,Auto" Margin="0,2">
              <TextBlock Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" VerticalAlignment="Center" Margin="6,0" />
              <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" Margin="6,0" FontSize="11" />
              <Button Grid.Column="3" Content="✕" FontSize="10" Padding="4,0" Command="{Binding CancelCommand}" IsVisible="{Binding IsActive}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Collapsible sidebar (PRD §6.2) -->
    <Border DockPanel.Dock="Left" Width="210" Padding="6"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Sidebar}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SidebarItemViewModel">
              <StackPanel Margin="0,1">
                <!-- Section header -->
                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="2,8,0,2"
                           IsVisible="{Binding IsHeader}" Opacity="0.7" FontSize="12" />
                <!-- Navigable favorite / drive -->
                <Button IsVisible="{Binding IsNavigable}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Background="Transparent" Padding="4,3"
                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenSidebarItemCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Glyph}" FontSize="12" />
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding UsedFraction}" Height="4"
                                 Margin="0,3,0,0" IsVisible="{Binding HasCapacity}" />
                    <TextBlock Text="{Binding FreeSpaceDisplay}" FontSize="10" Opacity="0.6"
                               IsVisible="{Binding HasCapacity}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Panes with splitter (PRD §6.2 dual pane) -->
    <Grid x:Name="PaneGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="{Binding IsDualPane, Converter={x:Static views:MainWindow.PaneColumnWidthConverter}}" />
      </Grid.ColumnDefinitions>
      <views:PaneView Grid.Column="0" DataContext="{Binding LeftPane}" />
      <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"
                    IsVisible="{Binding IsDualPane}" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <views:PaneView Grid.Column="2" DataContext="{Binding RightPane}"
                      IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsDualPane}" />
    </Grid>

  </DockPanel>
</Window>
