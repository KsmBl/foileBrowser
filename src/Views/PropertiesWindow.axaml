<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FoileBrowser.Views.PropertiesWindow"
        Width="440" SizeToContent="Height" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Properties">
  <StackPanel Margin="16" Spacing="10">

    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock x:Name="GlyphText" FontSize="22" VerticalAlignment="Center" />
      <TextBlock x:Name="NameText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
      <Grid.Styles>
        <Style Selector="TextBlock.label">
          <Setter Property="Opacity" Value="0.65" />
          <Setter Property="Margin" Value="0,3,8,3" />
        </Style>
        <Style Selector="SelectableTextBlock.value">
          <Setter Property="Margin" Value="0,3,0,3" />
          <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
      </Grid.Styles>

      <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Type" />
      <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="value" x:Name="TypeText" />

      <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Location" />
      <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="value" x:Name="LocationText" />

      <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Full path" />
      <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="value" x:Name="PathText" />

      <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Size" />
      <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="value" x:Name="SizeText" />

      <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="Modified" />
      <SelectableTextBlock Grid.Row="4" Grid.Column="1" Classes="value" x:Name="ModifiedText" />

      <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="Created" />
      <SelectableTextBlock Grid.Row="5" Grid.Column="1" Classes="value" x:Name="CreatedText" />

      <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="Permissions" x:Name="PermsLabel" />
      <SelectableTextBlock Grid.Row="6" Grid.Column="1" Classes="value" x:Name="PermsText" />
    </Grid>

    <!-- Default application for this file's type; changing it re-registers the association (PRD §6.9) -->
    <Grid ColumnDefinitions="110,*,Auto" x:Name="DefaultAppRow" IsVisible="False">
      <TextBlock Grid.Column="0" Text="Opens with" Opacity="0.65" VerticalAlignment="Center" Margin="0,3,8,3" />
      <ComboBox Grid.Column="1" x:Name="DefaultAppBox" HorizontalAlignment="Stretch"
                ToolTip.Tip="The application used for every file of this type" />
      <Button Grid.Column="2" x:Name="SetDefaultButton" Content="Set default" Margin="8,0,0,0"
              Click="OnSetDefaultApp" IsEnabled="False" />
    </Grid>
    <TextBlock x:Name="DefaultAppStatus" Opacity="0.7" FontSize="12" IsVisible="False" Margin="110,-4,0,0" />

    <Button Content="Close" HorizontalAlignment="Right" Click="OnClose" IsDefault="True" IsCancel="True" />
  </StackPanel>
</Window>
