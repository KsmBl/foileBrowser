<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FoileBrowser.Views.FormatWindow" Classes="dialog"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Format device">
  <StackPanel Margin="16" Spacing="10">

    <TextBlock x:Name="TargetText" FontWeight="SemiBold" TextWrapping="Wrap" />

    <Border Background="#33E06C6C" BorderBrush="#E06C6C" BorderThickness="1" CornerRadius="4" Padding="8">
      <TextBlock TextWrapping="Wrap" FontSize="12"
                 Text="⚠  This permanently ERASES all data on the device. This cannot be undone." />
    </Border>

    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Filesystem" VerticalAlignment="Center" />
      <ComboBox Grid.Row="0" Grid.Column="1" x:Name="FsBox" HorizontalAlignment="Stretch" SelectionChanged="OnFsChanged" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Label (optional)" VerticalAlignment="Center" Margin="0,8,0,0" />
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="LabelBox" Margin="0,8,0,0" Watermark="e.g. Backup" />
    </Grid>

    <StackPanel Spacing="4">
      <TextBlock x:Name="ConfirmPrompt" FontSize="12" TextWrapping="Wrap" />
      <TextBox x:Name="ConfirmBox" Watermark="Type the device name to confirm"
               TextChanged="OnConfirmChanged" />
    </StackPanel>

    <TextBlock x:Name="StatusText" Foreground="#E06C6C" TextWrapping="Wrap" FontSize="12" IsVisible="False" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="90" Height="4" VerticalAlignment="Center" IsVisible="False" />
      <Button Content="Cancel" Click="OnCancel" />
      <Button x:Name="FormatButton" Content="Format" Click="OnFormat" IsEnabled="False" />
    </StackPanel>
  </StackPanel>
</Window>
