<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FoileBrowser.ViewModels"
             xmlns:views="using:FoileBrowser.Views"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
             x:Class="FoileBrowser.Views.PaneView"
             x:DataType="vm:PaneViewModel">

  <!-- A subtle border highlights the active pane (PRD §6.3 operations act on it) -->
  <Border BorderThickness="2" Padding="1"
          BorderBrush="{Binding IsActive, Converter={x:Static views:PaneView.ActiveBorderConverter}}">
    <DockPanel>
      <!-- Compact folder-tab strip — only shown when the pane holds more than one folder tab
           (a single-folder pane relies on the dock's own pane tab, avoiding a duplicate row). -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding HasMultipleTabs}" Padding="2,2,2,0"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
        <ItemsControl ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FileTabViewModel">
              <Button Padding="8,3" FontSize="12" CornerRadius="4,4,0,0"
                      Background="{Binding IsSelectedTab, Converter={x:Static views:PaneView.SelectedTabBackgroundConverter}}"
                      Command="{Binding $parent[ItemsControl].((vm:PaneViewModel)DataContext).SelectTabCommand}"
                      CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                  <Button Content="✕" Padding="4,0" FontSize="10" Background="Transparent"
                          Command="{Binding $parent[ItemsControl].((vm:PaneViewModel)DataContext).CloseTabCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- Active folder view (ViewLocator resolves FileTabViewModel → FileTabView) -->
      <ContentControl Content="{Binding ActiveTab}" />
    </DockPanel>
  </Border>
</UserControl>
