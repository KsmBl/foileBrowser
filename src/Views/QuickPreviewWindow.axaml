<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:FoileBrowser.Views"
        xmlns:models="using:FoileBrowser.Models"
        x:Class="FoileBrowser.Views.QuickPreviewWindow"
        x:DataType="models:PreviewResult"
        Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        Title="Quick Preview">
  <views:PreviewView />
</Window>
