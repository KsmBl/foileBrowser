<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FoileBrowser.ViewModels"
             xmlns:models="using:FoileBrowser.Models"
             xmlns:svc="using:FoileBrowser.Services"
             xmlns:views="using:FoileBrowser.Views"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
             x:Class="FoileBrowser.Views.FileTabView"
             x:DataType="vm:FileTabViewModel">

  <DockPanel>

    <!-- Per-tab navigation toolbar + editable path bar (PRD §6.1) -->
    <Border DockPanel.Dock="Top" Padding="4" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,6,*,Auto,Auto">
        <Button Grid.Column="0" Content="←" ToolTip.Tip="Back (Alt+Left)" Command="{Binding GoBackCommand}" />
        <Button Grid.Column="1" Content="→" ToolTip.Tip="Forward (Alt+Right)" Command="{Binding GoForwardCommand}" Margin="3,0,0,0" />
        <Button Grid.Column="2" Content="↑" ToolTip.Tip="Up (Alt+Up)" Command="{Binding GoUpCommand}" Margin="3,0,0,0" />
        <Button Grid.Column="3" Content="⟳" ToolTip.Tip="Refresh (F5)" Command="{Binding RefreshCommand}" Margin="3,0,0,0" />
        <!-- Combined path bar: clickable breadcrumbs, click the empty area (or Ctrl+L) to edit the path -->
        <Panel Grid.Column="5">
          <Border IsVisible="{Binding !IsEditingPath}" Background="Transparent" Cursor="Ibeam"
                  PointerPressed="OnPathBarPressed" ToolTip.Tip="Click a segment to jump, or click here to type a path (Ctrl+L)"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1"
                  CornerRadius="3" Padding="2,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="1" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BreadcrumbSegment">
                    <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Text="›" Opacity="0.5" VerticalAlignment="Center" Margin="2,0"
                                 IsVisible="{Binding ShowSeparator}" />
                      <Button Content="{Binding Name}" Padding="6,2" FontSize="12" Background="Transparent"
                              Command="{Binding $parent[ItemsControl].((vm:FileTabViewModel)DataContext).NavigateBreadcrumbCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <TextBox x:Name="PathEntry" IsVisible="{Binding IsEditingPath}"
                   Text="{Binding PathBarText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Watermark="Type a path and press Enter" VerticalContentAlignment="Center"
                   LostFocus="OnPathEntryLostFocus">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding NavigatePathBarCommand}" />
              <KeyBinding Gesture="Escape" Command="{Binding CancelEditPathCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
        </Panel>
        <ToggleButton Grid.Column="6" Content="Hidden" ToolTip.Tip="Show hidden files"
                      IsChecked="{Binding ShowHidden, Mode=TwoWay}" Margin="3,0,0,0" />
        <!-- Show/hide THIS pane's navigation sidebar (favorites/drives/partitions/devices) -->
        <ToggleButton Grid.Column="7" Content="☰" ToolTip.Tip="Show/hide this pane's navigation sidebar"
                      Margin="3,0,0,0" IsChecked="{Binding IsSidebarVisible, Mode=TwoWay}" />
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="6,3" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusLine}" VerticalAlignment="Center" FontSize="12" />
        <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="90" Height="3"
                     IsVisible="{Binding IsLoading}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Filter (as-you-type) + recursive search bar (PRD §6.4); hideable, revealed on demand by Ctrl+F -->
    <Border DockPanel.Dock="Top" Padding="4,3" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1"
            IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSearchBarVisible}">
      <Grid ColumnDefinitions="*,6,*,Auto,Auto">
        <TextBox Grid.Column="0" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="Filter this folder…" FontSize="12" />
        <TextBox Grid.Column="2" x:Name="SearchBox" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="Search subtree (Enter, Esc to dismiss)…" FontSize="12" KeyDown="OnSearchBoxKeyDown">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding StartSearchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <TextBox Grid.Column="3" Text="{Binding SearchExtensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90"
                 Watermark="ext,ext" FontSize="12" Margin="4,0,0,0"
                 ToolTip.Tip="Restrict search to these extensions (comma-separated) — press Enter to search by extension alone">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding StartSearchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="4" Content="✕" Margin="4,0,0,0" Command="{Binding StopSearchCommand}"
                IsVisible="{Binding IsSearching}" ToolTip.Tip="Stop search / clear" />
      </Grid>
    </Border>

    <!-- Sortable column header -->
    <Grid DockPanel.Dock="Top" Margin="4,2,20,0" ColumnDefinitions="26,*,120,100,140">
      <Button Grid.Column="1" Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.Name}" Content="Name" />
      <Button Grid.Column="2" Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.Size}" Content="Size" />
      <Button Grid.Column="3" Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.Type}" Content="Type" />
      <Button Grid.Column="4" Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.Modified}" Content="Modified" />
    </Grid>

    <!-- This pane's own navigation sidebar (favorites/drives/partitions/devices), toggled per pane -->
    <Border DockPanel.Dock="Left" Width="185" Padding="6" IsVisible="{Binding IsSidebarVisible}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
      <ScrollViewer>
        <!-- Sidebar sections (Favorites/Drives/Devices/Folder tree). Drag a section header to reorder. -->
        <ItemsControl x:Name="SidebarSectionsHost" DragDrop.AllowDrop="True"
                      ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Sections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SidebarSectionViewModel">
              <StackPanel Margin="0,0,0,4">
                <!-- Draggable section header -->
                <Border Background="Transparent" Cursor="SizeAll" Margin="0,6,0,2"
                        ToolTip.Tip="Drag to reorder sections"
                        PointerPressed="OnSectionHeaderPressed" PointerMoved="OnSectionHeaderMoved">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="⠿" Opacity="0.4" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>

                <!-- Items (favorites / drives / partitions / devices) -->
                <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding !IsTree}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SidebarItemViewModel">
                      <StackPanel Margin="0,1">
                        <!-- Physical disk group; its partitions are indented below -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,4,0,1" IsVisible="{Binding IsDiskGroup}">
                          <TextBlock Text="{Binding Glyph}" FontSize="12" />
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Opacity="0.8" FontSize="12" />
                        </StackPanel>
                        <!-- Navigable favorite / drive / partition / device (navigates THIS pane) -->
                        <Grid IsVisible="{Binding IsNavigable}" ColumnDefinitions="*,Auto"
                              Margin="{Binding Indent, Converter={x:Static views:MainWindow.IndentConverter}}">
                          <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                  Background="Transparent" Padding="4,3"
                                  Command="{Binding $parent[UserControl].((vm:FileTabViewModel)DataContext).OpenSidebarItemCommand}"
                                  CommandParameter="{Binding}">
                            <Button.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Open" Command="{Binding OpenCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Open in New Tab" Command="{Binding OpenInNewTabCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Open in New Pane" Command="{Binding OpenInNewPaneCommand}" CommandParameter="{Binding}" />
                                <Separator IsVisible="{Binding HasActions}" />
                                <MenuItem Header="Eject / Unmount" IsVisible="{Binding IsEjectable}"
                                          Command="{Binding EjectCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Format / create filesystem…" IsVisible="{Binding CanFormat}"
                                          Command="{Binding FormatCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Unpin from favorites" IsVisible="{Binding CanUnpin}"
                                          Command="{Binding UnpinCommand}" CommandParameter="{Binding}" />
                              </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Glyph}" FontSize="12" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <ProgressBar Minimum="0" Maximum="1" Value="{Binding UsedFraction}" Height="4"
                                           Margin="0,3,0,0" IsVisible="{Binding HasCapacity}" />
                              <TextBlock Text="{Binding FreeSpaceDisplay}" FontSize="10" Opacity="0.6" IsVisible="{Binding HasCapacity}" />
                              <TextBlock Text="{Binding FileSystem}" FontSize="10" Opacity="0.5" IsVisible="{Binding HasFileSystem}" />
                            </StackPanel>
                          </Button>
                          <Button Grid.Column="1" Content="⏏" FontSize="12" Padding="5,0" Background="Transparent"
                                  VerticalAlignment="Center" ToolTip.Tip="Eject / unmount" IsVisible="{Binding IsEjectable}"
                                  Command="{Binding EjectCommand}" CommandParameter="{Binding}" />
                        </Grid>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Folder-tree navigator; navigates this pane on selection -->
                <TreeView IsVisible="{Binding IsTree}"
                          ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TreeRoots}"
                          SelectionChanged="OnTreeSelectionChanged">
                  <TreeView.ItemContainerTheme>
                    <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}"
                                  x:DataType="vm:FolderNodeViewModel">
                      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </ControlTheme>
                  </TreeView.ItemContainerTheme>
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:FolderNodeViewModel">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="📁" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </StackPanel>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Virtualized file list -->
    <ListBox x:Name="FileList" ItemsSource="{Binding Entries}"
             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
             SelectionMode="Multiple"
             SelectionChanged="OnListSelectionChanged"
             DoubleTapped="OnEntryActivated"
             KeyDown="OnListKeyDown"
             PointerPressed="OnListPointerPressed"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <!-- Right-click actions (DataContext is set to the shell view-model in code-behind). -->
      <ListBox.ContextMenu>
        <ContextMenu x:Name="EntryMenu" x:DataType="vm:MainWindowViewModel" Opening="OnEntryMenuOpening">
          <!-- Type to filter the actions below; Enter runs the first match (PRD §6.6). -->
          <TextBox x:Name="MenuSearchBox" Watermark="Search actions…" Margin="4,2" MinWidth="200"
                   TextChanged="OnMenuSearchChanged" KeyDown="OnMenuSearchKeyDown" />
          <Separator />
          <MenuItem Header="Open" Command="{Binding OpenSelectedExternallyCommand}" />
          <Separator />
          <MenuItem Header="Copy to other pane" InputGesture="F6" Command="{Binding CopyToOtherCommand}" />
          <MenuItem Header="Move to other pane" InputGesture="F7" Command="{Binding MoveToOtherCommand}" />
          <MenuItem Header="Rename…" InputGesture="F2" Command="{Binding RenameSelectedCommand}" />
          <MenuItem Header="Delete to trash" InputGesture="Delete" Command="{Binding DeleteSelectedCommand}" />
          <Separator />
          <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" />
          <MenuItem Header="Copy name" Command="{Binding CopyNameCommand}" />
          <Separator />
          <MenuItem Header="Extract archive here" Command="{Binding ExtractHereCommand}" />
          <MenuItem Header="Identify file" Command="{Binding IdentifyFileCommand}" />
          <Separator />
          <MenuItem Header="Tag" ItemsSource="{Binding TagPalette}">
            <MenuItem.ItemContainerTheme>
              <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="svc:TagColor">
                <Setter Property="Header" Value="{Binding Name}" />
                <Setter Property="Command"
                        Value="{Binding #EntryMenu.((vm:MainWindowViewModel)DataContext).AssignTagCommand}" />
                <Setter Property="CommandParameter" Value="{Binding Hex}" />
              </ControlTheme>
            </MenuItem.ItemContainerTheme>
          </MenuItem>
          <MenuItem Header="Clear tag" Command="{Binding ClearTagCommand}" />
          <Separator />
          <MenuItem Header="Properties" InputGesture="Alt+Enter" Command="{Binding ShowPropertiesCommand}" />
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.Styles>
        <Style Selector="Button.header">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Padding" Value="3,2" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="MinHeight" Value="24" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:FileEntryViewModel">
          <Grid ColumnDefinitions="26,*,120,100,140" MinHeight="{DynamicResource RowHeight}">
            <Panel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Glyph}" FontSize="12" />
              <!-- Color-tag dot (PRD §6.7) -->
              <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"
                       IsVisible="{Binding HasTag}"
                       Fill="{Binding TagColor, Converter={x:Static views:MainWindow.BrushConverter}}" />
            </Panel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                        Opacity="{Binding IsHidden, Converter={x:Static vm:BoolOpacityConverter.Instance}}">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding LocationDisplay}" IsVisible="{Binding HasLocation}"
                         FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <!-- Size — folders show a running "…/300 MiB+" while counting in the background (PRD §6.2) -->
            <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" FontSize="12"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="3" Text="{Binding TypeDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
            <TextBlock Grid.Column="4" Text="{Binding ModifiedDisplay}" VerticalAlignment="Center" FontSize="12" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</UserControl>
