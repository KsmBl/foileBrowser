<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FoileBrowser.ViewModels"
             xmlns:models="using:FoileBrowser.Models"
             xmlns:svc="using:FoileBrowser.Services"
             xmlns:views="using:FoileBrowser.Views"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
             x:Class="FoileBrowser.Views.FileTabView"
             x:DataType="vm:FileTabViewModel">

  <DockPanel>

    <!-- Per-tab navigation toolbar + editable path bar (PRD §6.1) -->
    <Border DockPanel.Dock="Top" Padding="4" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,6,*,Auto,Auto">
        <Button Grid.Column="0" Content="←" ToolTip.Tip="Back (Alt+Left)" Command="{Binding GoBackCommand}" />
        <Button Grid.Column="1" Content="→" ToolTip.Tip="Forward (Alt+Right)" Command="{Binding GoForwardCommand}" Margin="3,0,0,0" />
        <Button Grid.Column="2" Content="↑" ToolTip.Tip="Up (Alt+Up)" Command="{Binding GoUpCommand}" Margin="3,0,0,0" />
        <Button Grid.Column="3" Content="⟳" ToolTip.Tip="Refresh (F5)" Command="{Binding RefreshCommand}" Margin="3,0,0,0" />
        <!-- Combined path bar: clickable breadcrumbs, click the empty area (or Ctrl+L) to edit the path -->
        <Panel Grid.Column="5">
          <Border IsVisible="{Binding !IsEditingPath}" Background="Transparent" Cursor="Ibeam"
                  PointerPressed="OnPathBarPressed" ToolTip.Tip="Click a segment to jump, or click here to type a path (Ctrl+L)"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1"
                  CornerRadius="3" Padding="2,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="1" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BreadcrumbSegment">
                    <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Text="›" Opacity="0.5" VerticalAlignment="Center" Margin="2,0"
                                 IsVisible="{Binding ShowSeparator}" />
                      <Button Content="{Binding Name}" Padding="6,2" FontSize="12" Background="Transparent"
                              Command="{Binding $parent[ItemsControl].((vm:FileTabViewModel)DataContext).NavigateBreadcrumbCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <TextBox x:Name="PathEntry" IsVisible="{Binding IsEditingPath}"
                   Text="{Binding PathBarText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Watermark="Type a path and press Enter" VerticalContentAlignment="Center"
                   LostFocus="OnPathEntryLostFocus">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding NavigatePathBarCommand}" />
              <KeyBinding Gesture="Escape" Command="{Binding CancelEditPathCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
        </Panel>
        <ToggleButton Grid.Column="6" Content="Hidden" ToolTip.Tip="Show hidden files"
                      IsChecked="{Binding ShowHidden, Mode=TwoWay}" Margin="3,0,0,0" />
        <!-- Show/hide the global operations toolbar from within the tab (like the Hidden toggle) -->
        <ToggleButton Grid.Column="7" Content="🧰" ToolTip.Tip="Show/hide the operations toolbar" Margin="3,0,0,0"
                      IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsToolbarVisible, Mode=OneWay}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleToolbarCommand}" />
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="6,3" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" />
        <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="90" Height="3"
                     IsVisible="{Binding IsLoading}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Filter (as-you-type) + recursive search bar (PRD §6.4) -->
    <Border DockPanel.Dock="Top" Padding="4,3" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,6,*,Auto,Auto">
        <TextBox Grid.Column="0" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="Filter this folder…" FontSize="12" />
        <TextBox Grid.Column="2" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="Search subtree (Enter)…" FontSize="12">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding StartSearchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <TextBox Grid.Column="3" Text="{Binding SearchExtensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90"
                 Watermark="ext,ext" FontSize="12" Margin="4,0,0,0"
                 ToolTip.Tip="Restrict search to these extensions (comma-separated) — press Enter to search by extension alone">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding StartSearchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="4" Content="✕" Margin="4,0,0,0" Command="{Binding StopSearchCommand}"
                IsVisible="{Binding IsSearching}" ToolTip.Tip="Stop search / clear" />
      </Grid>
    </Border>

    <!-- Sortable column header -->
    <Grid DockPanel.Dock="Top" Margin="4,2,20,0" ColumnDefinitions="26,*,120,100,140">
      <Button Grid.Column="1" Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.Name}" Content="Name" />
      <Button Grid.Column="2" Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.Size}" Content="Size" />
      <Button Grid.Column="3" Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.Type}" Content="Type" />
      <Button Grid.Column="4" Classes="header" Command="{Binding SortByCommand}" CommandParameter="{x:Static models:SortColumn.Modified}" Content="Modified" />
    </Grid>

    <!-- Virtualized file list -->
    <ListBox ItemsSource="{Binding Entries}"
             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
             DoubleTapped="OnEntryActivated"
             KeyDown="OnListKeyDown"
             PointerPressed="OnListPointerPressed"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <!-- Right-click actions (DataContext is set to the shell view-model in code-behind). -->
      <ListBox.ContextMenu>
        <ContextMenu x:Name="EntryMenu" x:DataType="vm:MainWindowViewModel">
          <MenuItem Header="Open" Command="{Binding OpenSelectedExternallyCommand}" />
          <Separator />
          <MenuItem Header="Copy to other pane" InputGesture="F6" Command="{Binding CopyToOtherCommand}" />
          <MenuItem Header="Move to other pane" InputGesture="F7" Command="{Binding MoveToOtherCommand}" />
          <MenuItem Header="Rename…" InputGesture="F2" Command="{Binding RenameSelectedCommand}" />
          <MenuItem Header="Delete to trash" InputGesture="Delete" Command="{Binding DeleteSelectedCommand}" />
          <Separator />
          <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" />
          <MenuItem Header="Copy name" Command="{Binding CopyNameCommand}" />
          <Separator />
          <MenuItem Header="Extract archive here" Command="{Binding ExtractHereCommand}" />
          <MenuItem Header="Identify file" Command="{Binding IdentifyFileCommand}" />
          <Separator />
          <MenuItem Header="Tag" ItemsSource="{Binding TagPalette}">
            <MenuItem.ItemContainerTheme>
              <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="svc:TagColor">
                <Setter Property="Header" Value="{Binding Name}" />
                <Setter Property="Command"
                        Value="{Binding #EntryMenu.((vm:MainWindowViewModel)DataContext).AssignTagCommand}" />
                <Setter Property="CommandParameter" Value="{Binding Hex}" />
              </ControlTheme>
            </MenuItem.ItemContainerTheme>
          </MenuItem>
          <MenuItem Header="Clear tag" Command="{Binding ClearTagCommand}" />
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.Styles>
        <Style Selector="Button.header">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Padding" Value="3,2" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="MinHeight" Value="24" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:FileEntryViewModel">
          <Grid ColumnDefinitions="26,*,120,100,140" MinHeight="{DynamicResource RowHeight}">
            <Panel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Glyph}" FontSize="12" />
              <!-- Color-tag dot (PRD §6.7) -->
              <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"
                       IsVisible="{Binding HasTag}"
                       Fill="{Binding TagColor, Converter={x:Static views:MainWindow.BrushConverter}}" />
            </Panel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                        Opacity="{Binding IsHidden, Converter={x:Static vm:BoolOpacityConverter.Instance}}">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding LocationDisplay}" IsVisible="{Binding HasLocation}"
                         FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <!-- Size — folders show a running "…/300 MiB+" while counting in the background (PRD §6.2) -->
            <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" FontSize="12"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="3" Text="{Binding TypeDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
            <TextBlock Grid.Column="4" Text="{Binding ModifiedDisplay}" VerticalAlignment="Center" FontSize="12" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</UserControl>
