<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FoileBrowser.ViewModels"
        xmlns:views="using:FoileBrowser.Views"
        x:Class="FoileBrowser.Views.SettingsWindow"
        x:DataType="views:SettingsWindow"
        Width="540" Height="580" MinWidth="440" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Title="Settings">
  <DockPanel Margin="12">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Foreground="#E06C6C" VerticalAlignment="Center" Margin="0,0,8,0" />
      <Button Content="Cancel" Click="OnCancel" />
      <Button Content="Save" Click="OnSave" IsDefault="True" />
    </StackPanel>

    <TabControl>

      <!-- General -->
      <TabItem Header="General">
        <StackPanel Margin="4,12" Spacing="12">
          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Theme" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ThemeBox" HorizontalAlignment="Stretch">
              <ComboBoxItem>System</ComboBoxItem>
              <ComboBoxItem>Light</ComboBoxItem>
              <ComboBoxItem>Dark</ComboBoxItem>
            </ComboBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Accent color" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="AccentBox" Watermark="#3D8BFD" Margin="0,8,0,0" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Font size" VerticalAlignment="Center" Margin="0,8,0,0" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="FontBox" Minimum="9" Maximum="24" Increment="1" Margin="0,8,0,0" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Row height" VerticalAlignment="Center" Margin="0,8,0,0" />
            <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="RowHeightBox" Minimum="18" Maximum="48" Increment="2" Margin="0,8,0,0" />
          </Grid>

          <CheckBox x:Name="SearchBarBox" Content="Show the filter/search bar in each pane (else use Ctrl+F to reveal it)" />
        </StackPanel>
      </TabItem>

      <!-- Toolbar buttons (PRD §6.8) -->
      <TabItem Header="Toolbar">
        <DockPanel Margin="4,10">
          <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontSize="12" Opacity="0.7"
                     Text="Show or hide individual buttons on the top operations toolbar." />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding ToolbarOptions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolbarOption">
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Disks (destructive — PRD §6.10) -->
      <TabItem Header="Disks">
        <DockPanel Margin="4,10">
          <StackPanel DockPanel.Dock="Top" Spacing="8">
            <CheckBox x:Name="EnableFormatBox"
                      Content="Enable formatting drives &amp; partitions (creates new filesystems — destructive)" />
            <Border Background="#33E06C6C" BorderBrush="#E06C6C" BorderThickness="1" CornerRadius="4" Padding="8">
              <TextBlock TextWrapping="Wrap" FontSize="12"
                         Text="⚠  When enabled, a “Format / create filesystem…” action appears in the sidebar context menu for drives and partitions. It runs mkfs as root via pkexec and ERASES the target. Always double-check the device." />
            </Border>
            <TextBlock Text="Filesystems to offer in the format dialog:" Margin="0,4,0,0" Opacity="0.75" FontSize="12" />
            <TextBlock x:Name="NoMkfsText" IsVisible="False" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                       Text="No mkfs.* tools were found on this system. Install e.g. e2fsprogs, dosfstools, exfatprogs, ntfs-3g to enable formatting." />
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding FormatFilesystemOptions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolbarOption">
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Keybinds (interactive capture — PRD §6.6) -->
      <TabItem Header="Keybinds">
        <DockPanel Margin="4,10">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="Click a shortcut, then press the keys to bind it." Opacity="0.7" VerticalAlignment="Center" FontSize="12" />
            <Button Content="Reset all" Click="OnResetAllKeybinds" FontSize="12" Padding="6,2" />
          </StackPanel>
          <ScrollViewer>
            <ItemsControl x:Name="KeybindList" ItemsSource="{Binding Keybinds}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KeybindRow">
                  <Grid ColumnDefinitions="*,150,Auto,Auto" Margin="0,2">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Conflict}" FontSize="10" Foreground="#E06C6C" IsVisible="{Binding HasConflict}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Content="{Binding Display}" IsChecked="{Binding IsCapturing, Mode=OneWay}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12"
                                  Click="OnCaptureClick" Tag="{Binding}" />
                    <Button Grid.Column="2" Content="Reset" FontSize="11" Padding="6,2" Margin="4,0,0,0"
                            Click="OnResetKeybind" Tag="{Binding}" ToolTip.Tip="Reset to default" />
                    <Button Grid.Column="3" Content="✕" FontSize="11" Padding="6,2" Margin="4,0,0,0"
                            Click="OnClearKeybind" Tag="{Binding}" ToolTip.Tip="Unbind" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
