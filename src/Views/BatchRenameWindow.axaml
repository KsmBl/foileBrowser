<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FoileBrowser.ViewModels"
        xmlns:models="using:FoileBrowser.Models"
        xmlns:views="using:FoileBrowser.Views"
        x:Class="FoileBrowser.Views.BatchRenameWindow"
        x:DataType="vm:BatchRenameViewModel"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        Title="Batch Rename">
  <DockPanel Margin="12">

    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <Grid ColumnDefinitions="90,*,90,*">
        <TextBlock Grid.Column="0" Text="Find" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Find, Mode=TwoWay}" Watermark="(empty = template mode)" />
        <TextBlock Grid.Column="2" Text="Replace" VerticalAlignment="Center" Margin="10,0,0,0" />
        <TextBox Grid.Column="3" Text="{Binding Replace, Mode=TwoWay}" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <CheckBox Content="Regex" IsChecked="{Binding UseRegex, Mode=TwoWay}" />
        <CheckBox Content="Ignore case" IsChecked="{Binding CaseInsensitive, Mode=TwoWay}" />
        <TextBlock Text="Counter start" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding CounterStart, Mode=TwoWay}" Minimum="0" Width="90" />
        <TextBlock Text="Step" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding CounterStep, Mode=TwoWay}" Minimum="1" Width="80" />
        <TextBlock Text="Pad" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding CounterPadding, Mode=TwoWay}" Minimum="1" Maximum="8" Width="70" />
      </StackPanel>
      <TextBlock Text="Tokens: {name} {ext} {n} {date} {date:yyyy-MM}" Opacity="0.6" FontSize="11" />
      <TextBlock Text="{Binding Error}" Foreground="#E5484D" IsVisible="{Binding Error, Converter={x:Static views:BatchRenameWindow.NotNullConverter}}"
                 TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancel" Click="OnCancel" />
      <Button Content="Apply" Click="OnApply" IsDefault="True" />
    </StackPanel>

    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Margin="0,10">
      <ListBox ItemsSource="{Binding Proposals}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="models:RenameProposal">
            <Grid ColumnDefinitions="*,20,*" Height="22">
              <TextBlock Grid.Column="0" Text="{Binding OriginalName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.7" />
              <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding ProposedName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         FontWeight="{Binding Changed, Converter={x:Static views:BatchRenameWindow.ChangedWeightConverter}}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

  </DockPanel>
</Window>
