<Project>

  <!--
    Four assembly names ship in both format bundles: FileFormat.Dicom, .Nifti, .Wad and .Wad2 exist
    in CompressionWorkbench's archive/filesystem packages *and* in PNGCrushCS's image package,
    holding different types under the same simple name. Only one can land in the output, and
    MSBuild's conflict resolution picks the higher assembly version — which is always
    CompressionWorkbench's (1.0.0.696 against 1.0.0.8).

    That is not a build error. It surfaces at run time as a TypeLoadException the moment the image
    registry initialises, and because that happens in a static constructor it takes every image
    decode down with it — no previews, no thumbnails, no metadata columns.

    So the image copies are forced to win. The two registries fail differently and that decides it:
    the image registry names its types directly in generated registration code, so a missing one
    throws on first use; ours discovers CompressionWorkbench descriptors by scanning referenced
    assemblies (src/Generators), so an assembly that is not there is simply never registered. The
    cost is that DICOM, NIfTI and WAD are no longer offered as *archives* — which for a file browser
    is a fair trade against images not rendering at all.

    Applied here rather than in a csproj so it covers the app and the test project alike, and both
    the compile references and the files copied to the output.
  -->
  <Target Name="DropCollidingFormatAssemblies"
          AfterTargets="ResolveAssemblyReferences"
          Condition="'$(MSBuildProjectName)' == 'FoileBrowser' Or '$(MSBuildProjectName)' == 'FoileBrowser.Tests'">
    <ItemGroup>
      <_LosingCollision
        Include="@(ReferencePath)"
        Condition="('%(FileName)' == 'FileFormat.Dicom' Or '%(FileName)' == 'FileFormat.Nifti' Or '%(FileName)' == 'FileFormat.Wad' Or '%(FileName)' == 'FileFormat.Wad2')
                   And ($([System.String]::Copy('%(Identity)').Contains('hawkynt.fileformats.archives'))
                        Or $([System.String]::Copy('%(Identity)').Contains('hawkynt.fileformats.filesystems')))" />

      <ReferencePath Remove="@(_LosingCollision)" />
      <ReferenceCopyLocalPaths Remove="@(_LosingCollision)" />

      <!--
        Removing the loser is only half of it. Conflict resolution has already discarded the image
        package's copy by this point, so dropping CompressionWorkbench's would leave the name
        resolving to nothing at all — which fails the same way, just with FileNotFound instead of
        TypeLoad. The image copies are put back explicitly.
      -->
      <_ImageFormatWinner Include="$(NuGetPackageRoot)hawkynt.fileformats.images\$(HawkyntImagesVersion)\lib\net8.0\FileFormat.Dicom.dll" />
      <_ImageFormatWinner Include="$(NuGetPackageRoot)hawkynt.fileformats.images\$(HawkyntImagesVersion)\lib\net8.0\FileFormat.Nifti.dll" />
      <_ImageFormatWinner Include="$(NuGetPackageRoot)hawkynt.fileformats.images\$(HawkyntImagesVersion)\lib\net8.0\FileFormat.Wad.dll" />
      <_ImageFormatWinner Include="$(NuGetPackageRoot)hawkynt.fileformats.images\$(HawkyntImagesVersion)\lib\net8.0\FileFormat.Wad2.dll" />

      <ReferencePath Include="@(_ImageFormatWinner)" Condition="Exists('%(Identity)')" />
      <ReferenceCopyLocalPaths Include="@(_ImageFormatWinner)" Condition="Exists('%(Identity)')" />
    </ItemGroup>

    <Error Condition="'@(_LosingCollision)' != '' And '@(_ImageFormatWinner)' == ''"
           Text="The colliding CompressionWorkbench assemblies were dropped but the image package's replacements were not found under $(NuGetPackageRoot)hawkynt.fileformats.images\$(HawkyntImagesVersion)." />
  </Target>

  <!--
    Publish computes its own file list, so the swap above has to be repeated for it — otherwise
    `dotnet publish` (and NativeAOT, which is the default install) ships CompressionWorkbench's copies
    again. ILC reports it as "RegisterAll() will always throw", which is a warning rather than an
    error: the binary builds and then has no image support at all.
  -->
  <Target Name="DropCollidingFormatAssembliesOnPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(MSBuildProjectName)' == 'FoileBrowser'">
    <ItemGroup>
      <_LosingPublishCollision
        Include="@(ResolvedFileToPublish)"
        Condition="('%(FileName)' == 'FileFormat.Dicom' Or '%(FileName)' == 'FileFormat.Nifti' Or '%(FileName)' == 'FileFormat.Wad' Or '%(FileName)' == 'FileFormat.Wad2')
                   And ($([System.String]::Copy('%(Identity)').Contains('hawkynt.fileformats.archives'))
                        Or $([System.String]::Copy('%(Identity)').Contains('hawkynt.fileformats.filesystems')))" />

      <ResolvedFileToPublish Remove="@(_LosingPublishCollision)" />
    </ItemGroup>

    <Message Importance="normal"
             Text="Dropped @(_LosingPublishCollision->Count()) colliding assemblies from the publish set." />
  </Target>

</Project>
