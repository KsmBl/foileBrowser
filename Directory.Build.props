<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The base version every project inherits; the build number is appended at release time by
         .github/workflows/scripts/version.pl from the commit count. Versions come from files, never
         from a git tag. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Named once: the PackageReference uses it, and Directory.Build.targets needs the same
         version to locate the assemblies it puts back after the name collision is resolved. -->
    <HawkyntImagesVersion>1.0.0.8</HawkyntImagesVersion>
  </PropertyGroup>

</Project>
