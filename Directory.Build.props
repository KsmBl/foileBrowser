<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The base version every project inherits; the build number is appended at release time by
         .github/workflows/scripts/version.pl from the commit count. Versions come from files, never
         from a git tag. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <HawkyntImagesVersion>1.0.0.145</HawkyntImagesVersion>
    <!-- The UI toolkit. Each of its packages carries its own build number (its own folder's commit
         count), so there is no single toolkit version to pin — the three move independently and are
         listed separately. Only consulted when NativeFormsSource=package (the default); see
         src/FoileBrowser.csproj. -->
    <NativeFormsVersion>1.0.0.224</NativeFormsVersion>
    <NativeFormsGtkVersion>1.0.0.72</NativeFormsGtkVersion>
    <NativeFormsWindowsVersion>1.0.0.63</NativeFormsWindowsVersion>
    <NativeFormsMacOSVersion>1.0.0.92</NativeFormsMacOSVersion>
  </PropertyGroup>

</Project>
